# lab-trading 환경변수 가이드
# production은 Cloudflare 대시보드 vars 또는 `wrangler secret put`을 사용.
# 로컬 개발은 .dev.vars (gitignore) 또는 .env.local.

# ─────────────────────────────────────────────────────────────────
# 사이트 (필수)
# ─────────────────────────────────────────────────────────────────

# 사이트 절대 URL — canonical/hreflang/OG/JSON-LD/sitemap에 사용.
# 미설정 시 http://localhost:3000 폴백 (lib/site.ts).
NEXT_PUBLIC_SITE_URL=https://trading.jdgrid.com

# ─────────────────────────────────────────────────────────────────
# 코인 데이터 (ADR-0005)
# ─────────────────────────────────────────────────────────────────

# CoinGecko Demo 키 — 30/min, 10K/mo 무료.
# 발급: https://www.coingecko.com/en/developers/dashboard
# 미설정 시 CoinGecko Public(5-15/min IP 기준)으로 폴백 (한도 불안정).
COINGECKO_API_KEY=cg-demo-xxxxxxxxxxxxxx

# Upbit Quotation, Binance Public — 키 불필요 (시세 엔드포인트)
# 단, IP 기반 한도가 있어 Workers 다중 PoP 분산 효과 의존.

# CoinMarketCap Fear & Greed (코인 공포·탐욕 지수, /market).
# 키 있으면 공식 Pro API (X-CMC_PRO_API_KEY, 깨끗한 ToS) 사용, 없으면 웹 data-api(무키, ToS-gray) 폴백.
# Basic(무료) 플랜 OK — 15K credit/월. 발급: https://pro.coinmarketcap.com/account
# production: `wrangler secret put CMC_API_KEY` (저장소에 올리지 말 것).
CMC_API_KEY=

# ─────────────────────────────────────────────────────────────────
# 해외 주식 데이터 (ADR-0006)
# ─────────────────────────────────────────────────────────────────

# Twelve Data 무료 — 800/day, 8/min, 글로벌 90+ 거래소
# 발급: https://twelvedata.com/account/api-keys
TWELVE_DATA_API_KEY=xxxxxxxxxxxxxxxxxxxx

# Phase 1.5 옵션 — FMP / Polygon (펀더멘털·정확도 보강)
# FMP_API_KEY=...
# POLYGON_API_KEY=...

# ─────────────────────────────────────────────────────────────────
# 국내 주식 데이터 (ADR-0007, Phase 1.5)
# ─────────────────────────────────────────────────────────────────

# KIS Open API — 한국투자증권 비대면 계좌 + 모의투자 가입 후 발급
# 발급: https://apiportal.koreainvestment.com/intro
KIS_APP_KEY=
KIS_APP_SECRET=
# 모의(`vts` 도메인) vs 실(`prod` 도메인) 환경 선택
KIS_ENV=vts

# KRX OPEN API — 일별 종마감 데이터
# 발급: https://openapi.krx.co.kr/
KRX_API_KEY=

# 공공데이터포털 — 금융위 주식시세정보 (일봉 백테스트 데이터)
# 발급: https://www.data.go.kr/data/15094808/openapi.do
DATA_GO_KR_KEY=

# OpenDART — 전자공시 (공시·재무)
# 발급: https://opendart.fss.or.kr/
OPENDART_API_KEY=

# ─────────────────────────────────────────────────────────────────
# 환율 (ADR-0024)
# ─────────────────────────────────────────────────────────────────

# Frankfurter — 무인증 (1차 출시 기본)
# Phase 1.5: 한국은행 ECOS
# 발급: https://ecos.bok.or.kr/api/
# ECOS_API_KEY=

# ─────────────────────────────────────────────────────────────────
# Cloudflare Bindings (wrangler.jsonc 에 정의, env 변수 아님 — 참고용)
# ─────────────────────────────────────────────────────────────────

# DB         — D1 namespace binding (ADR-0021)
# LAB_KV     — KV namespace binding (ADR-0009)
# BACKUP     — R2 bucket binding (ADR-0021 주간 백업)
# ASSETS     — 정적 자산 (open-next 기본)
# ANALYTICS  — Workers Analytics Engine dataset (ADR-0023)

# wrangler.jsonc 예시 (ADR-0021 채택 후 셸 부트 시 작성):
# {
#   "name": "lab-trading",
#   "compatibility_date": "2025-12-01",
#   "compatibility_flags": ["nodejs_compat"],
#   "main": ".open-next/worker.js",
#   "assets": {"directory": ".open-next/assets", "binding": "ASSETS"},
#   "d1_databases": [{"binding": "DB", "database_name": "lab-trading-db", "database_id": "..."}],
#   "kv_namespaces": [{"binding": "LAB_KV", "id": "..."}],
#   "r2_buckets": [{"binding": "BACKUP", "bucket_name": "lab-trading-backup"}],
#   "analytics_engine_datasets": [{"binding": "ANALYTICS", "dataset": "lab_trading_metrics"}],
#   "vars": {}
# }
